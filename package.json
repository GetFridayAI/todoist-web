{
  "name": "todoist",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "start::ios": "expo run:ios",
    "start::ipad": "expo start --ios",
    "start::web": "node ./scripts/start-web.js",
    "start::web-mock": "node ./scripts/start-web.js --mock",
    "prebuild:ios": "expo prebuild --platform ios",
    "mac": "npm run prebuild:ios && echo 'Open the ios workspace and add a Mac target (Mac Catalyst or react-native-macos). See PLATFORM_SETUP.md.'",
    "watch": "npm run prebuild:ios && echo 'Open the ios workspace and add a watchOS companion target. See PLATFORM_SETUP.md.'",
    "clean": "expo start --clear",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@expo/vector-icons$": "<rootDir>/__mocks__/expoVectorIcons.js",
      "^@react-native-vector-icons/.*$": "<rootDir>/__mocks__/reactNativeVectorIcons.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-router-dom)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-vector-icons/evil-icons": "^13.1.1",
    "@react-native-vector-icons/fontawesome-free-solid": "^1.1.1",
    "@react-native-vector-icons/material-icons": "^13.1.1",
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.18",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "reactNativeVectorIcons": {
    "fontDir": "src/rnvi-fonts"
  }
}
